<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.safar.dailyjob</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/scripts/__RUN_SCRIPT__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <!-- Fires at 9:00 AM local time. If the Mac is asleep at that moment,
         launchd runs it as soon as the machine wakes up. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/output/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/output/launchd.error.log</string>
</dict>
</plist>
