# ---- Which LLM writes captions/scripts by default ----
# "openai" or "anthropic". You only need to fill in the section below for
# whichever provider(s) you actually use; --compare-providers needs both.
TEXT_PROVIDER=openai

# ---- OpenAI (content brains) ----
OPENAI_API_KEY=sk-...
# Text/caption model. GPT-5 family once available on your account, e.g. "gpt-5" or "gpt-5-mini".
OPENAI_TEXT_MODEL=gpt-5
# Image model used to generate/extend hero shots from your uploaded product photos.
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Anthropic / Claude (alternative caption writer) ----
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5 (default, best quality/cost balance) or claude-haiku-4-5-20251001 (cheapest)
ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# ---- Facebook Page (Graph API) ----
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Instagram (Business account, via the same Graph API app) ----
IG_BUSINESS_ACCOUNT_ID=

# ---- YouTube Data API v3 (OAuth2, generated once via scripts/youtube_oauth_setup.py) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ---- Public media hosting (Instagram requires a public URL for anything it posts) ----
# "github": free, commits generated media to a branch of this repo and serves
#   it via raw.githubusercontent.com. Repo must be public. Needs GITHUB_TOKEN
#   (a personal access token with contents read/write on this repo) + GITHUB_REPO.
# "s3": needs an AWS account, bucket, and credentials below.
MEDIA_HOST_PROVIDER=github

GITHUB_TOKEN=
GITHUB_REPO=youruser/yourrepo
GITHUB_MEDIA_BRANCH=media

# Only needed if MEDIA_HOST_PROVIDER=s3
PUBLIC_MEDIA_BASE_URL=https://your-cdn-or-bucket.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ---- Scheduling behaviour ----
# Day of week (Mon=0 ... Sun=6) the weekly long-form YouTube video gets produced/published.
WEEKLY_VIDEO_WEEKDAY=6
# Safety switch: agent runs in dry-run (no real posting) unless explicitly told --publish.
DRY_RUN=true
